generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TUTOR
  HOD
  GUARD
  ADMIN
}

enum OutpassStatus {
  PENDING_TUTOR
  PENDING_HOD
  APPROVED
  EXITED
  RETURNED
  REJECTED
  CANCELLED
  EXPIRED
  OVERDUE
}

enum OutpassType {
  NORMAL
  EMERGENCY
}

enum Decision {
  APPROVED
  REJECTED
}

enum ScanDirection {
  EXIT
  ENTRY
}

model User {
  id        String    @id @default(uuid())
  name      String
  role      Role
  mobile    String    @unique
  department String?
  year      Int?
  division  String?
  status    String    @default("ACTIVE")
  student   Student?
  devices   Device[]
  sessions  Session[]
  tutorOf   Student[] @relation("TutorStudents")
  // inverse relations for department assignments
  hodOf       Department? @relation("DeptHod")
  deputyHodOf Department? @relation("DeptDeputyHod")
  adminOf     Department? @relation("DeptAdmin")
  // inverse for class tutoring
  tutorClasses TutorClass[] @relation("TutorClasses")
  createdAt DateTime  @default(now())

  @@index([role, status])
  @@index([department])
}

model Student {
  userId     String           @id
  user       User             @relation(fields: [userId], references: [id])
  registerNo String           @unique
  department String
  semester   Int
  year       Int?
  division   String?
  tutorId    String?
  studentClasses StudentClass[] @relation("StudentClassStudent")
  tutor      User?            @relation("TutorStudents", fields: [tutorId], references: [id])
  outpasses  OutpassRequest[]

  @@index([tutorId])
  @@index([department, year, division])
}

model Device {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  platform   String    @default("web")
  publicKey  String
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @updatedAt

  @@index([userId])
}

model Otp {
  id        String    @id @default(uuid())
  mobile    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([mobile, createdAt])
}

model Session {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  refreshTokenHash String  @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model OutpassRequest {
  id               String        @id @default(uuid())
  displayId        String        @unique
  studentId        String
  student          Student       @relation(fields: [studentId], references: [userId])
  type             OutpassType   @default(NORMAL)
  status           OutpassStatus @default(PENDING_TUTOR)
  requestedExitAt  DateTime
  expectedReturnAt DateTime
  destination      String
  purposeCategory  String
  purposeText      String?
  validFrom        DateTime?
  validUntil       DateTime?
  exitAt           DateTime?
  entryAt          DateTime?
  exitGateId       String?
  entryGateId      String?
  lastTokenTs      BigInt        @default(0)
  version          Int           @default(1)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  approvals        Approval[]
  gateEvents       GateEvent[]

  @@index([status])
  @@index([studentId, createdAt])
  @@index([validUntil])
}

model Approval {
  id          String   @id @default(uuid())
  requestId   String
  request     OutpassRequest @relation(fields: [requestId], references: [id])
  stage       String
  approverId  String
  decision    Decision
  comment     String?
  decidedAt   DateTime @default(now())

  @@unique([requestId, stage])
  @@index([approverId])
  @@index([requestId])
}

model Gate {
  id               String @id @default(uuid())
  name             String
  directionDefault String @default("BOTH")
}

model GateEvent {
  id           String        @id @default(uuid())
  outpassId    String?
  request      OutpassRequest? @relation(fields: [outpassId], references: [id])
  gateId       String
  guardId      String
  deviceId     String
  direction    ScanDirection
  resultCode   String
  offline      Boolean       @default(false)
  detail       String?
  clientScanId String        @unique
  scannedAt    DateTime      @default(now())

  @@index([guardId, scannedAt])
  @@index([outpassId])
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  at         DateTime  @default(now())
  actorId    String?
  actorRole  String?
  action     String
  objectType String
  objectId   String?
  detail     String?
  prevHash   String?
  hash       String?

  @@index([actorId])
  @@index([action])
  @@index([at])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Department {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  hodId     String? @unique
  deputyHodId String? @unique
  adminId   String? @unique
  divisions Division[]
  createdAt DateTime   @default(now())

  // relations
  hod       User?      @relation("DeptHod", fields: [hodId], references: [id])
  deputyHod User?      @relation("DeptDeputyHod", fields: [deputyHodId], references: [id])
  admin     User?      @relation("DeptAdmin", fields: [adminId], references: [id])

  // inverse for classes belonging to department
  classes   Class[]
}

model Division {
  id           String     @id @default(uuid())
  name         String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([departmentId, name])
}

model AcademicYear {
  id        String   @id @default(uuid())
  year      Int      @unique
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  semesters Semester[]
}

model Semester {
  id             String   @id @default(uuid())
  name           String   // e.g., "Fall", "Spring"
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classes Class[]
}

model Class {
  id          String   @id @default(uuid())
  name        String   // e.g., "CS101"
  departmentId String
  department  Department @relation(fields: [departmentId], references: [id])
  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id])
  year        Int
  division    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studentAssignments StudentClass[]
  tutorAssignments   TutorClass[]

  @@unique([departmentId, semesterId, name])
}

model StudentClass {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  assignedAt DateTime @default(now())
  revokedAt DateTime?

  student   Student @relation("StudentClassStudent", fields: [studentId], references: [userId])
  class     Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, classId])
  @@index([classId])
}

model TutorClass {
  id        String   @id @default(uuid())
  tutorId   String
  classId   String
  assignedAt DateTime @default(now())
  revokedAt DateTime?

  tutor     User @relation("TutorClasses", fields: [tutorId], references: [id])
  class     Class @relation(fields: [classId], references: [id])

  @@unique([tutorId, classId, assignedAt])
  @@index([classId])
}

model RolePermission {
  id          String @id @default(uuid())
  role        Role
  permission  String
  createdAt   DateTime @default(now())

  @@unique([role, permission])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  actorId   String?
  actorRole Role?
  eventType String
  detail    String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([eventType])
}

model AppSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}


